{
    "workbench.preferredDarkColorTheme": "Dark Horizon", // change for dark mode
    "workbench.preferredLightColorTheme": "Github Light Theme", // change for light mode
    "workbench.preferredHighContrastColorTheme": "Dark Modern",
    "workbench.preferredHighContrastLightColorTheme": "Light Modern",
    "window.autoDetectColorScheme": false,
    "window.autoDetectHighContrast": false,
    "workbench.experimental.modernUI": false,

    "workbench.colorCustomizations": {
