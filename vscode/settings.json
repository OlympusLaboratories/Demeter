    "peacock.affectTitleBar": true,
    "peacock.affectActivityBar": true,
    "peacock.affectStatusBar": true,
    "peacock.keepBadgeColor": true,
    "peacock.showColorInStatusBar": true,

    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "bottom",
    "workbench.editorLargeFileConfirmation": 100,
    "editor.accessibilitySupport": "off",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "python.formatting.provider": "black",
    "python.linting.flake8Enabled": true,
    "eslint.debug": true,
    "eslint.format.enable": true,
    "eslint.packageManager": "yarn",
    "eslint.workingDirectories": [],
    "jupyter.askForKernelRestart": false,
    "notebook.output.textLineLimit": 200,
    "notebook.output.scrolling": true,
    "makefile.configureOnOpen": true,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "git.openRepositoryInParentFolders": "never",
    "extensions.autoUpdate": "off",
    "security.promptForRemoteFileProtocolHandling": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.shellIntegration.enabled": false,
    "redhat.telemetry.enabled": true,
    "azureTerraform.survey": {
        "surveyPromptDate": "never",
        "surveyPromptIgnoredCount": 0
    },
    "claudeCode.preferredLocation": "panel",
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "claudeCode.hideOnboarding": true,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.agentSessions.showExternal": "last30Days",
    "github.copilot.chat.claudeAgent.allowAutoPermissions": true,
    "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,

    "window.zoomLevel": 4,
    "claudemeter.debugLogFile": "/Users/dylanlarrabee/Library/Application Support/claudemeter/debug.log",
    "chat.titleBar.signIn.enabled": false,
    "workbench.colorTheme": "Dark Horizon",
    "terminal.integrated.initialHint": false,
    "worktreeSync.direction": "both",
    "claudeCode.claudeProcessWrapper": "/Users/dylanlarrabee/Demeter/vscode/claude-wrapper.sh",
    "claudeUsage.barStyle": "squares"
}
