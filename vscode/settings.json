            "editorSuggestWidget.selectedBackground": "#CDE3F8",
            "editorSuggestWidget.selectedForeground": "#000000",
            "editorSuggestWidget.highlightForeground": "#0F4A85",
            "editorActionList.focusBackground": "#CDE3F8",
            "editorActionList.focusForeground": "#000000",
            "chat.slashCommandBackground": "#D2ECFF",
            "chat.slashCommandForeground": "#0F4A85"
        }
