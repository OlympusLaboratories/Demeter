.vscode/

# Override global gitignore — we DO want to track settings.local.json in this repo
!profiles/*/.claude/.claude/settings.local.json

# Skill user data — lives in skill dirs but not tracked
profiles/*/.claude/skills/reflect-week/slack-context.md
profiles/*/.claude/skills/reflect-self/context/
profiles/*/.claude/skills/reflect-self/prompts.md
profiles/*/.claude/skills/reflect-peer/context/
profiles/*/.claude/skills/reflect-peer/prompts.md