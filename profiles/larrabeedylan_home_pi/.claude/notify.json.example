{
  "_comment": "A thread per session is why this box is on Slack with the Mac: a flat chat interleaves a dozen concurrent sessions unreadably. The telegram section below still works and is the one-word fallback - set transport back to \"telegram\" and nothing else changes. Its bot_token_file/chat_id_file form is right there because this box already holds that credential for its own alerting, so there is one owner per credential and no second copy to rotate; the _file forms win only when the direct key is empty, and they work for the slack keys too.",
  "transport": "slack",
  "slack": {
    "bot_token": "REPLACE_ME",
    "channel": "REPLACE_ME",
    "mention": "REPLACE_ME",
    "webhook_url": ""
  },
  "telegram": {
    "bot_token_file": "~/.telegram-jarvis-token",
    "chat_id_file": "~/.telegram-alert-chat"
  },
  "_host_label": "What a notification calls a session that is not inside a checkout. Every phone session starts in one fixed directory here, so without this every ping from this box would carry the same uninformative word.",
  "host_label": "pi",
  "min_turn_seconds": 60,
  "min_interval_seconds": 30,
  "quiet_hours": null,
  "only_when_armed": true,
  "notify_when_blocked": true,
  "summarize": {
    "command": "",
    "model": "claude-haiku-4-5-20251001",
    "max_words": 68,
    "timeout": 180,
    "title_timeout": 25
  },
  "events": {
    "stop": true,
    "permission": true,
    "question": true,
    "idle": true,
    "failure": true
  }
}
